---
import { siteConfig } from "../config";
import SectionHeading from "./SectionHeading.astro";

const hasEducation = siteConfig.education && siteConfig.education.length > 0;
---

{
  hasEducation && (
    <section id="education" class="border-b-2 border-ink bg-tint-blue">
      <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-20 2xl:max-w-[1440px]">
        <SectionHeading
          index="04"
          eyebrow="Background"
          title="Education"
        />

        <div class="mt-10 grid gap-6 md:grid-cols-2">
          {siteConfig.education.map((edu) => (
            <article class="border-2 border-ink bg-surface shadow-hard">
              <div class="border-b-2 border-ink bg-tint-blue px-5 py-4">
                <span class="inline-block border-2 border-ink bg-surface px-2 py-0.5 font-display text-[11px] font-bold uppercase tracking-wider text-muted">
                  {edu.dateRange}
                </span>
                <h3 class="mt-3 font-display text-lg font-black uppercase leading-tight tracking-tight sm:text-xl">
                  {edu.degree}
                </h3>
                <p
                  class="mt-1 font-display text-sm font-bold uppercase tracking-wide"
                  style={{ color: siteConfig.accentColor }}
                >
                  {edu.school}
                </p>
              </div>

              <ul class="space-y-3 p-5">
                {edu.achievements.map((achievement) => (
                  <li class="flex items-start gap-3 text-sm leading-relaxed text-muted sm:text-base">
                    <span class="mt-2 h-2 w-2 shrink-0 bg-ink" />
                    <span>{achievement}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>
  )
}
