---
import { siteConfig } from "../config";

const [firstName, ...rest] = siteConfig.name.split(" ");
const lastName = rest.join(" ");
---

<section id="hero" class="border-b-2 border-ink bg-white">
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-20 md:py-28 2xl:max-w-[1440px]">
    <div>
        <span
          class="inline-block border-2 border-ink bg-surface px-3 py-1 font-display text-xs font-bold uppercase tracking-widest shadow-hard-sm"
        >
          Hello
        </span>

        <h1
          class="mt-7 font-display text-4xl font-black uppercase leading-[0.88] tracking-tight sm:text-5xl md:text-6xl lg:text-7xl xl:text-8xl"
        >
          {firstName}
          <span class="block text-accent">{lastName}</span>
        </h1>

        <p
          class="mt-6 max-w-xl font-display text-lg font-semibold uppercase tracking-wide text-muted sm:text-xl md:text-2xl"
        >
          {siteConfig.title}
        </p>

        <div class="mt-8 flex flex-wrap gap-4">
          <a
            href="/cv.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 border-2 border-ink bg-accent px-5 py-3 font-display text-sm font-bold uppercase tracking-wider text-white shadow-hard transition-transform duration-150 hover:translate-x-[3px] hover:translate-y-[3px] hover:shadow-hard-sm active:translate-x-[6px] active:translate-y-[6px] active:shadow-none"
          >
            Download CV
            <img src="/download.svg" alt="" class="h-4 w-4 invert" />
          </a>
          <a
            href={`mailto:${siteConfig.social.email}`}
            class="inline-flex items-center border-2 border-ink bg-surface px-5 py-3 font-display text-sm font-bold uppercase tracking-wider text-ink shadow-hard transition-transform duration-150 hover:translate-x-[3px] hover:translate-y-[3px] hover:shadow-hard-sm active:translate-x-[6px] active:translate-y-[6px] active:shadow-none"
          >
            Email me
          </a>
        </div>

        <div class="mt-10 flex flex-wrap gap-3">
          {
            siteConfig.social?.email && (
              <a
                href={`mailto:${siteConfig.social.email}`}
                aria-label="Email"
                class="flex h-11 w-11 items-center justify-center border-2 border-ink bg-surface text-ink transition-colors duration-150 hover:bg-accent hover:text-white"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-5 w-5"
                >
                  <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                  <path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z" />
                  <path d="M3 7l9 6l9 -6" />
                </svg>
              </a>
            )
          }
          {
            siteConfig.social?.linkedin && (
              <a
                href={siteConfig.social.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="LinkedIn"
                class="flex h-11 w-11 items-center justify-center border-2 border-ink bg-surface text-ink transition-colors duration-150 hover:bg-accent hover:text-white"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-5 w-5"
                >
                  <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                  <path d="M8 11v5" />
                  <path d="M8 8v.01" />
                  <path d="M12 16v-5" />
                  <path d="M16 16v-3a2 2 0 1 0 -4 0" />
                  <path d="M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4z" />
                </svg>
              </a>
            )
          }
          {
            siteConfig.social?.twitter && (
              <a
                href={siteConfig.social.twitter}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Twitter"
                class="flex h-11 w-11 items-center justify-center border-2 border-ink bg-surface text-ink transition-colors duration-150 hover:bg-accent hover:text-white"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-5 w-5"
                >
                  <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                  <path d="M4 4l11.733 16h4.267l-11.733 -16z" />
                  <path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772" />
                </svg>
              </a>
            )
          }
          {
            siteConfig.social?.github && (
              <a
                href={siteConfig.social.github}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="GitHub"
                class="flex h-11 w-11 items-center justify-center border-2 border-ink bg-surface text-ink transition-colors duration-150 hover:bg-accent hover:text-white"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-5 w-5"
                >
                  <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                  <path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5" />
                </svg>
              </a>
            )
          }
        </div>
    </div>
  </div>
</section>
