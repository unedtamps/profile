---
import { siteConfig } from "../config";
import SectionHeading from "./SectionHeading.astro";

const experience = siteConfig.experience ?? [];
const hasExperience = experience.length > 0;
---

{
  hasExperience && (
    <section id="experience" class="border-b-2 border-ink bg-white">
      <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-20 2xl:max-w-[1440px]">
        <SectionHeading
          index="03"
          eyebrow="Where I've worked"
          title="Experience"
        />

        <ol class="mt-10">
          {experience.map((exp, index) => {
            const isLast = index === experience.length - 1;
            return (
              <li class="grid grid-cols-[92px_1fr] gap-x-3 sm:grid-cols-[176px_1fr] sm:gap-x-6">
                <div
                  class:list={[
                    "relative flex flex-col items-end pr-3.5 text-right sm:pr-5",
                    isLast ? "pb-0" : "pb-10",
                  ]}
                >
                  <span
                    class:list={[
                      "absolute right-0 w-[3px] bg-ink",
                      isLast ? "top-0 h-6" : "inset-y-0",
                    ]}
                  />
                  <span class="mt-1 font-display text-[10px] font-bold uppercase leading-snug tracking-wider text-muted sm:text-xs">
                    {exp.dateRange}
                  </span>
                  <span
                    class="absolute right-[-5.5px] top-1.5 z-10 h-3.5 w-3.5 border-2 border-ink bg-accent"
                    aria-hidden="true"
                  />
                </div>

                <div class:list={[isLast ? "pb-0" : "pb-10", "min-w-0"]}>
                  <p
                    class="font-display text-xs font-bold uppercase tracking-wide"
                    style={{ color: siteConfig.accentColor }}
                  >
                    {exp.company}
                  </p>
                  <h3 class="mt-1 font-display text-lg font-black uppercase leading-tight tracking-tight sm:text-xl">
                    {exp.title}
                  </h3>
                  <ul class="mt-4 space-y-3">
                    {exp.bullets.map((bullet) => (
                      <li class="flex items-start gap-3 text-sm leading-relaxed text-muted sm:text-base">
                        <span class="mt-2 h-2 w-2 shrink-0 bg-ink" />
                        <span>{bullet}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </li>
            );
          })}
        </ol>
      </div>
    </section>
  )
}
