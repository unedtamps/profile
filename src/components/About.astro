---
import { siteConfig } from "../config";
import SectionHeading from "./SectionHeading.astro";
---

<section id="about" class="border-b-2 border-ink bg-tint-blue">
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-20 2xl:max-w-[1440px]">
    <SectionHeading index="01" eyebrow="Who I am" title="About Me" />

    <p
      class="mt-10 text-base leading-relaxed text-muted sm:text-lg md:text-xl"
    >
      {siteConfig.aboutMe}
    </p>
  </div>
</section>
