---
import { siteConfig } from "../config";

const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;
const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
const hasEducation = siteConfig.education && siteConfig.education.length > 0;

const socials = [
  { label: "Email", href: `mailto:${siteConfig.social.email}`, icon: "email" },
  { label: "LinkedIn", href: siteConfig.social.linkedin, icon: "linkedin" },
  { label: "Twitter", href: siteConfig.social.twitter, icon: "twitter" },
  { label: "GitHub", href: siteConfig.social.github, icon: "github" },
];
---

<footer class="border-t-4 border-ink bg-white">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 sm:py-16 2xl:max-w-[1440px]">
    <div class="grid gap-10 md:grid-cols-12">
      <div class="md:col-span-7">
        <p
          class="font-display text-3xl font-black uppercase leading-none tracking-tight sm:text-4xl md:text-5xl"
        >
          {siteConfig.name}
        </p>
        <p class="mt-3 font-display text-sm font-bold uppercase tracking-widest text-muted">
          {siteConfig.title}
        </p>

        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href={`mailto:${siteConfig.social.email}`}
            class="inline-flex items-center gap-2 border-2 border-ink bg-accent px-4 py-2 font-display text-xs font-bold uppercase tracking-wider text-white shadow-hard-sm transition-transform duration-150 hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-none"
          >
            Get in touch
          </a>
          <a
            href="/cv.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 border-2 border-ink bg-surface px-4 py-2 font-display text-xs font-bold uppercase tracking-wider text-ink shadow-hard-sm transition-transform duration-150 hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-none"
          >
            Download CV
          </a>
        </div>
      </div>

      <div class="md:col-span-5 md:justify-self-end">
        <nav class="flex flex-wrap gap-x-6 gap-y-2">
          <a
            href="#about"
            class="font-display text-xs font-bold uppercase tracking-widest text-muted transition-colors duration-150 hover:text-accent"
            >About</a
          >
          {
            hasProjects && (
              <a
                href="#projects"
                class="font-display text-xs font-bold uppercase tracking-widest text-muted transition-colors duration-150 hover:text-accent"
              >
                Projects
              </a>
            )
          }
          {
            hasExperience && (
              <a
                href="#experience"
                class="font-display text-xs font-bold uppercase tracking-widest text-muted transition-colors duration-150 hover:text-accent"
              >
                Experience
              </a>
            )
          }
          {
            hasEducation && (
              <a
                href="#education"
                class="font-display text-xs font-bold uppercase tracking-widest text-muted transition-colors duration-150 hover:text-accent"
              >
                Education
              </a>
            )
          }
        </nav>

        <div class="mt-6 flex flex-wrap gap-3">
          {
            socials.map((social) => (
              <a
                href={social.href}
                aria-label={social.label}
                target={social.icon === "email" ? undefined : "_blank"}
                rel="noopener noreferrer"
                class="flex h-10 w-10 items-center justify-center border-2 border-ink bg-paper text-ink transition-colors duration-150 hover:bg-accent hover:text-white"
              >
                {social.icon === "email" && (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="h-5 w-5"
                  >
                    <path
                      stroke="none"
                      d="M0 0h24v24H0z"
                      fill="none"
                    />
                    <path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z" />
                    <path d="M3 7l9 6l9 -6" />
                  </svg>
                )}
                {social.icon === "linkedin" && (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="h-5 w-5"
                  >
                    <path
                      stroke="none"
                      d="M0 0h24v24H0z"
                      fill="none"
                    />
                    <path d="M8 11v5" />
                    <path d="M8 8v.01" />
                    <path d="M12 16v-5" />
                    <path d="M16 16v-3a2 2 0 1 0 -4 0" />
                    <path d="M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4z" />
                  </svg>
                )}
                {social.icon === "twitter" && (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="h-5 w-5"
                  >
                    <path
                      stroke="none"
                      d="M0 0h24v24H0z"
                      fill="none"
                    />
                    <path d="M4 4l11.733 16h4.267l-11.733 -16z" />
                    <path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772" />
                  </svg>
                )}
                {social.icon === "github" && (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="h-5 w-5"
                  >
                    <path
                      stroke="none"
                      d="M0 0h24v24H0z"
                      fill="none"
                    />
                    <path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5" />
                  </svg>
                )}
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-3 border-t-2 border-ink pt-5 sm:flex-row sm:items-center sm:justify-between">
      <p class="font-display text-xs font-bold uppercase tracking-widest text-muted">
        © {new Date().getFullYear()} {siteConfig.name}. All rights reserved.
      </p>
      <a
        href="#hero"
        class="font-display text-xs font-bold uppercase tracking-widest text-muted transition-colors duration-150 hover:text-accent"
      >
        Back to top ↑
      </a>
    </div>
  </div>
</footer>
