---
import { siteConfig } from "../config";
import "aos/dist/aos.css"; 

const projects = siteConfig.projects ?? [];
const accentColor = siteConfig.accentColor;
const visibleCount = 3; 
const visibleProjects = projects.slice(0, visibleCount);
const hiddenProjects = projects.slice(visibleCount);
---

{projects.length > 0 && (
  <section id="projects" class="p-8 sm:p-12 md:p-16 lg:p-24 overflow-hidden">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16">
      
      <div class="lg:col-span-4">
        <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-900">
          Projects
        </h2>
        <div
          class="w-[75px] h-[5px] mt-2 rounded-full"
          style={`background-color: ${accentColor}`}
        />
      </div>

      <div class="lg:col-span-8">
        <div class="space-y-8">
          
          {visibleProjects.map((project, index) => {
             const linkProps = project.link ? {
               href: project.link,
               target: "_blank",
               rel: "noopener noreferrer"
             } : {};

             return (
              <div 
                class="project-wrapper group relative"
                data-aos="fade-left"
                data-aos-delay={index * 100}
              >
                <div
                  {...linkProps}
                  class={`block relative p-4 sm:p-6 md:p-8 bg-gray-50 rounded-xl sm:rounded-2xl border border-gray-200 transition-all duration-300 ${
                    project.link ? "hover:bg-white hover:shadow-xl hover:border-gray-300 hover:-translate-y-1" : ""
                  }`}
                >
                  {project.link && (
                    <a href={project.link}>
                      <div class="absolute top-4 right-4 sm:top-6 sm:right-6 md:top-8 md:right-8 w-10 h-10 sm:w-11 sm:h-11 md:w-12 md:h-12 flex items-center justify-center bg-gray-900 rounded-full text-white transition-all duration-300 group-hover:bg-gray-700">
                        <svg class="w-4 h-4 sm:w-5 sm:h-5 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7V17" /></svg>
                      </div>
                    </a>
                  )}

                  <div class="space-y-4">
                    <div>
                      <span class="text-sm font-mono" style={{ color: accentColor }}>0{index + 1}</span>
                      <h3 class="text-xl sm:text-2xl font-bold text-gray-900 mt-1">{project.name}</h3>
                    </div>
                    <div class="flex items-center justify-between mb-4 text-sm">
                      <div class="flex items-center gap-1 text-gray-700" title="Contributors">
                        <div class="w-7 h-7 bg-gray-200 rounded flex items-center justify-center">
                          <img src="/person.svg" alt="" class="w-4 h-4 opacity-70" />
                        </div>
                        <span>{project.contributors}</span>
                      </div>
                      <span class="text-xs sm:text-sm text-gray-500">
                        {project.dateRange}
                      </span>
                    </div>
                    <p class={`text-base sm:text-lg text-gray-600 leading-relaxed ${project.link ? "pr-12 sm:pr-14 md:pr-16" : ""}`}>{project.description}</p>
                    <div class="flex flex-wrap gap-2 pt-2">
                      {project.skills?.length && project.skills.map((skill) => (
                        <span class={`px-3 py-1 bg-gray-900 text-white rounded-lg text-xs sm:text-sm font-medium transition-all duration-300 ${project.link ? "group-hover:bg-gray-800" : ""}`}>{skill}</span>
                      ))}
                    </div>
                    
                    {(project.source || project.preview) && (
                      <div class="flex items-center gap-3 pt-4 border-t border-gray-200 mt-4">
                        {project.source && (
                          <a
                            href={project.source}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="flex items-center justify-center w-9 h-9 bg-gray-900 text-white rounded transition-all duration-300 hover:bg-gray-700"
                          >
                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                              <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
                            </svg>
                          </a>
                        )}
                        {project.preview && (
                          <button
                            class="preview-btn flex items-center justify-center w-9 h-9 bg-gray-900 text-white rounded transition-all duration-300 hover:bg-gray-700"
                            data-img={project.preview}
                            data-title={project.name}
                          >
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                            </svg>
                          </button>
                        )}
                      </div>
                    )}
                  </div>
                </div>
              </div>
             );
          })}

          {hiddenProjects.length > 0 && (
            <div 
              id="expandable-wrapper" 
              class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-500 ease-in-out"
            >
              <div class="overflow-hidden">
                <div class="space-y-8 pt-8"> 
                  {hiddenProjects.map((project, index) => {
                    const globalIndex = index + visibleCount;
                    
                    const linkProps = project.link ? { href: project.link, target: "_blank", rel: "noopener noreferrer" } : {};

                    return (
                      <div 
                        class="project-wrapper group relative"
                        data-aos="fade-left"
                        data-aos-delay={globalIndex * 100}
                      >
                        <div
                          {...linkProps}
                          class={`block relative p-4 sm:p-6 md:p-8 bg-gray-50 rounded-xl sm:rounded-2xl border border-gray-200 transition-all duration-300 ${
                            project.link ? "hover:bg-white hover:shadow-xl hover:border-gray-300 hover:-translate-y-1" : ""
                          }`}
                        >
                           {project.link && (
                             <div class="absolute top-4 right-4 sm:top-6 sm:right-6 md:top-8 md:right-8 w-10 h-10 sm:w-11 sm:h-11 md:w-12 md:h-12 flex items-center justify-center bg-gray-900 rounded-full text-white transition-all duration-300 group-hover:bg-gray-700">
                               <svg class="w-4 h-4 sm:w-5 sm:h-5 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7V17" /></svg>
                             </div>
                           )}
                           <div class="space-y-4">
                             <div>
                               <span class="text-sm font-mono" style={{ color: accentColor }}>0{globalIndex + 1}</span>
                               <h3 class="text-xl sm:text-2xl font-bold text-gray-900 mt-1">{project.name}</h3>
                             </div>

                    <div class="flex items-center justify-between mb-4 text-sm">
                      <div class="flex items-center gap-1 text-gray-700" title="Contributors">
                        <div class="w-7 h-7 bg-gray-200 rounded flex items-center justify-center">
                          <img src="/person.svg" alt="" class="w-4 h-4 opacity-70" />
                        </div>
                        <span>{project.contributors}</span>
                      </div>
                      <span class="text-xs sm:text-sm text-gray-500">
                        {project.dateRange}
                      </span>
                    </div>

                             <p class={`text-base sm:text-lg text-gray-600 leading-relaxed ${project.link ? "pr-12 sm:pr-14 md:pr-16" : ""}`}>{project.description}</p>
                             <div class="flex flex-wrap gap-2 pt-2">
                               {project.skills?.length && project.skills.map((skill) => (
                                 <span class={`px-3 py-1 bg-gray-900 text-white rounded-lg text-xs sm:text-sm font-medium transition-all duration-300 ${project.link ? "group-hover:bg-gray-800" : ""}`}>{skill}</span>
                               ))}
                             </div>

                            {(project.source || project.preview) && (
                              <div class="flex items-center gap-3 pt-4 border-t border-gray-200 mt-4">
                                {project.source && (
                                  <a
                                    href={project.source}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="flex items-center justify-center w-9 h-9 bg-gray-900 text-white rounded transition-all duration-300 hover:bg-gray-700"
                                  >
                                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                                      <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
                                    </svg>
                                  </a>
                                )}
                                {project.preview && (
                                  <button
                                    class="preview-btn flex items-center justify-center w-9 h-9 bg-gray-900 text-white rounded transition-all duration-300 hover:bg-gray-700"
                                    data-img={project.preview}
                                    data-title={project.name}
                                  >
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                    </svg>
                                  </button>
                                )}
                              </div>
                            )}
                           </div>
                        </div>
                      </div>
                    );
                  })}
                </div>
              </div>
            </div>
          )}

          {hiddenProjects.length > 0 && (
            <div class="flex justify-center mt-8">
              <button
                id="toggle-projects-btn"
                class="group p-3 rounded-full bg-gray-900 text-white hover:bg-gray-800 transition-all duration-300 hover:scale-110 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900"
                aria-label="Show more projects"
              >
                <svg
                  id="toggle-icon"
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-6 w-6 transition-transform duration-500 ease-in-out" 
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>
)}

<div id="image-modal" class="fixed inset-0 z-50 hidden">
  <div class="absolute inset-0 bg-black/90 backdrop-blur-sm" id="modal-backdrop"></div>
  <div class="absolute inset-0 flex items-center justify-center p-4">
    <div class="relative max-w-4xl w-full max-h-[90vh]">
      <button id="close-modal" class="absolute -top-12 right-0 text-white hover:text-gray-300 transition-colors">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
      <img id="modal-img" src="" alt="" class="w-full h-auto max-h-[85vh] object-contain rounded-lg shadow-2xl" />
      <p id="modal-caption" class="text-white text-center mt-4 text-lg font-medium"></p>
    </div>
  </div>
</div>


<script>
  import AOS from 'aos';
  
  AOS.refresh()
  
  const toggleBtn = document.getElementById('toggle-projects-btn');
  const toggleIcon = document.getElementById('toggle-icon');
  const expandableWrapper = document.getElementById('expandable-wrapper');
  
  let isExpanded = false;

  if (toggleBtn && toggleIcon && expandableWrapper) {
    toggleBtn.addEventListener('click', () => {
      isExpanded = !isExpanded;

      if (isExpanded) {
        toggleIcon.classList.add('rotate-180');
      } else {
        toggleIcon.classList.remove('rotate-180');
      }

      if (isExpanded) {
        expandableWrapper.classList.remove('grid-rows-[0fr]');
        expandableWrapper.classList.add('grid-rows-[1fr]');
      } else {
        expandableWrapper.classList.remove('grid-rows-[1fr]');
        expandableWrapper.classList.add('grid-rows-[0fr]');
      }

      setTimeout(() => {
        AOS.refresh();
      }, 500); 
    });
  }

  const modal = document.getElementById('image-modal');
  const modalImg = document.getElementById('modal-img') as HTMLImageElement;
  const modalCaption = document.getElementById('modal-caption');
  const closeModal = document.getElementById('close-modal');
  const modalBackdrop = document.getElementById('modal-backdrop');

  document.querySelectorAll('.preview-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const imgSrc = (btn as HTMLElement).dataset.img;
      const title = (btn as HTMLElement).dataset.title;
      if (modal && modalImg && modalCaption && imgSrc && title) {
        modalImg.src = imgSrc;
        modalCaption.textContent = title;
        modal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      }
    });
  });

  function closeImageModal() {
    if (modal) {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    }
  }

  if (closeModal) {
    closeModal.addEventListener('click', closeImageModal);
  }

  if (modalBackdrop) {
    modalBackdrop.addEventListener('click', closeImageModal);
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeImageModal();
    }
  });
</script>
