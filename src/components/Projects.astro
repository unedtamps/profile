---
import { siteConfig } from "../config";
import SectionHeading from "./SectionHeading.astro";

const projects = siteConfig.projects ?? [];
const visibleCount = 4;
const featured = projects.slice(0, visibleCount);
const others = projects.slice(visibleCount);

const pad = (n: number) => String(n).padStart(2, "0");

const stickyNotes = [
  "#bfdbfe",
  "#fbcfe8",
  "#a5f3fc",
  "#ddd6fe",
  "#fed7aa",
  "#bbf7d0",
];

const sticky = (index: number) => stickyNotes[(index * 5 + 1) % stickyNotes.length];

const visitClass =
  "inline-flex items-center gap-2 border-2 border-ink bg-accent px-3.5 py-2 font-display text-[11px] font-bold uppercase tracking-wider text-white shadow-hard-sm transition-transform duration-150 hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-none";

const sourceClass =
  "inline-flex items-center gap-2 border-2 border-ink bg-surface px-3.5 py-2 font-display text-[11px] font-bold uppercase tracking-wider text-ink shadow-hard-sm transition-transform duration-150 hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-none";
---

{
  projects.length > 0 && (
    <section id="projects" class="border-b-2 border-ink bg-tint-yellow">
      <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-20 2xl:max-w-[1440px]">
        <SectionHeading index="02" eyebrow="Selected work" title="Projects" />

        <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {featured.map((project, index) => (
            <article
              class="flex flex-col border-2 border-ink shadow-hard"
              style={{ background: sticky(index) }}
            >
              {project.preview && (
                <img
                  src={project.preview}
                  alt={`${project.name} preview`}
                  loading="lazy"
                  class="aspect-video w-full border-b-2 border-ink object-cover object-top"
                />
              )}

              <div class="flex flex-1 flex-col p-4 sm:p-5">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="border-2 border-ink bg-accent px-2 py-0.5 font-display text-[11px] font-black text-white">
                    {pad(index + 1)}
                  </span>
                </div>

                <h3 class="mt-3 font-display text-lg font-black uppercase leading-none tracking-tight sm:text-xl">
                  {project.name}
                </h3>

                <div class="mt-3 flex flex-wrap gap-1.5">
                  {(project.skills ?? []).map((skill) => (
                    <span class="border-2 border-ink bg-ink px-2 py-0.5 font-display text-[10px] font-bold uppercase tracking-wider text-white">
                      {skill}
                    </span>
                  ))}
                </div>

                <p class="mt-3 text-sm leading-relaxed text-muted">
                  {project.description}
                </p>

                <div class="mt-auto flex flex-wrap gap-2 pt-5">
                  {project.link && (
                    <a
                      href={project.link}
                      target="_blank"
                      rel="noopener noreferrer"
                      class={visitClass}
                    >
                      Visit
                      <svg
                        class="h-3 w-3"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2.5"
                          d="M7 17L17 7M17 7H7M17 7V17"
                        />
                      </svg>
                    </a>
                  )}
                  {project.source && (
                    <a
                      href={project.source}
                      target="_blank"
                      rel="noopener noreferrer"
                      class={sourceClass}
                    >
                      Source
                    </a>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>

        {others.length > 0 && (
          <div class="mt-16">
            <h3 class="font-display text-2xl font-black uppercase leading-none tracking-tight sm:text-3xl">
              Other interesting projects
            </h3>
            <div class="mt-4 h-1 w-full bg-ink" />

            <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
              {others.map((project, index) => {
                const number = index + visibleCount + 1;
                return (
                  <article
                    class="flex flex-col border-2 border-ink shadow-hard-sm"
                    style={{ background: sticky(index + visibleCount) }}
                  >
                    <div class="flex flex-wrap items-center justify-between gap-3 border-b-2 border-ink px-4 py-3">
                      <div class="flex items-center gap-3">
                        <span
                          class="font-display text-sm font-black"
                          style={{ color: siteConfig.accentColor }}
                        >
                          {pad(number)}
                        </span>
                        <h4 class="font-display text-base font-black uppercase leading-none tracking-tight sm:text-lg">
                          {project.name}
                        </h4>
                      </div>
                    </div>

              <div class="flex flex-1 flex-col p-3.5 sm:p-4">
                      <div class="flex flex-wrap gap-1.5">
                        {(project.skills ?? []).map((skill) => (
                          <span class="border-2 border-ink bg-ink px-2 py-0.5 font-display text-[10px] font-bold uppercase tracking-wider text-white">
                            {skill}
                          </span>
                        ))}
                      </div>

                      <p class="mt-3 text-sm leading-relaxed text-muted">
                        {project.description}
                      </p>

                      <div class="mt-auto flex flex-wrap gap-2 pt-5">
                        {project.link && (
                          <a
                            href={project.link}
                            target="_blank"
                            rel="noopener noreferrer"
                            class={visitClass}
                          >
                            Visit
                          </a>
                        )}
                        {project.source && (
                          <a
                            href={project.source}
                            target="_blank"
                            rel="noopener noreferrer"
                            class={sourceClass}
                          >
                            Source
                          </a>
                        )}
                      </div>
                    </div>
                  </article>
                );
              })}
            </div>
          </div>
        )}
      </div>
    </section>
  )
}
